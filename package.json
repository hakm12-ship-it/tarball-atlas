    "offline/atlas.html",
    "docs/lib",
    "LICENSE",
    "README.md",
    "README.ko.md"
  ],
  "scripts": {
    "test": "node --test",
    "build": "node scripts/build.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hakm12-ship-it/tarball-atlas.git"
  },
  "homepage": "https://hakm12-ship-it.github.io/tarball-atlas/",
  "bugs": {
    "url": "https://github.com/hakm12-ship-it/tarball-atlas/issues"
  },
  "keywords": [
    "npm",
    "tarball",
    "package-size",
    "release",
    "diff",
    "treemap",
    "ci"
  ],
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
