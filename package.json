{
  "name": "tarball-atlas",
  "version": "1.0.0",
  "description": "See exactly which files changed the size of an npm release. Browser, offline HTML reports, and a zero-dependency CLI.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "tarball-atlas": "./bin/atlas.mjs"
  },
  "files": [
